    {
      "id": "demo-supply-esg",
      "title": "SYNTHETIC DEMO \u2014 supply and ESG commentary",
      "publisher": "Synthetic Demo Dataset",
      "published_at": "2026-04-25",
      "text": "SYNTHETIC DEMO commentary: supply remains selective, ESG upgrades matter, and hybrid flight-to-quality supports well located efficient offices.",
      "submarket": "London",
      "category": "supply",
      "demo": true
    },
    {
      "id": "demo-demand",
      "title": "SYNTHETIC DEMO \u2014 Occupier demand and flight-to-quality",
      "publisher": "Synthetic Demo Dataset",
      "published_at": "2026-04-25",
      "text": "Office occupier demand in this synthetic scenario favours efficient Grade A buildings near transport. Flight-to-quality reflects a preference for amenity, energy performance and adaptable space, even where hybrid working reduces total desks. Older unrefurbished offices face weaker demand; this does not imply that all prime buildings will outperform.",
      "submarket": "London",
      "category": "demand",
      "demo": true
    },
    {
      "id": "demo-macro",
      "title": "SYNTHETIC DEMO \u2014 Interest rates and occupier drivers",
      "publisher": "Synthetic Demo Dataset",
      "published_at": "2026-04-25",
      "text": "In this synthetic scenario, lower interest rates may ease refinancing costs and support viable refurbishment, but borrowing margins and lender requirements still matter. Employment uncertainty can delay office leasing decisions. Hybrid working makes attendance patterns and space quality more important than headline headcount alone. These are scenario interpretations, not forecasts.",
      "submarket": "London",
      "category": "macro",
      "demo": true
    },
    {
      "id": "demo-westend",
      "title": "SYNTHETIC DEMO \u2014 West End demand commentary",
      "publisher": "Synthetic Demo Dataset",
      "published_at": "2026-04-25",
      "text": "In the synthetic West End scenario, limited large floorplates and occupier preference for central amenities support prime rents. Smaller available supply can leave tenants with fewer suitable options. This scenario explains the illustrative rent premium over City offices; it is not a live valuation.",
      "submarket": "West End",
      "category": "demand",
      "demo": true
    },
    {
      "id": "demo-city",
      "title": "SYNTHETIC DEMO \u2014 City demand commentary",
      "publisher": "Synthetic Demo Dataset",
      "published_at": "2026-04-25",
      "text": "The synthetic City scenario combines demand from professional services with competition from refurbished offices. Flight-to-quality favours efficient floorplates and transport access. Vacancy estimates differ between illustrative surveys; scope and building coverage must be reconciled before treating any one estimate as definitive.",
      "submarket": "City",
      "category": "demand",
      "demo": true
    },
    {
      "id": "demo-supply-risk",
      "title": "SYNTHETIC DEMO \u2014 Supply pipeline and pre-let risks",
      "publisher": "Synthetic Demo Dataset",
      "published_at": "2026-04-25",
      "text": "Synthetic supply pipeline risk centres on uncommitted future space and construction timing. Pre-lets reduce exposure to future leasing conditions, while refurbishment can improve energy performance but displace existing occupiers during works. Expected completion dates are plans rather than guarantees. Monitoring commitment and timing together is more useful than gross pipeline size alone.",
      "submarket": "London",
      "category": "supply",
      "demo": true
    },
    {
      "id": "demo-esg",
      "title": "SYNTHETIC DEMO \u2014 ESG refurbishment and hybrid work",
      "publisher": "Synthetic Demo Dataset",
      "published_at": "2026-04-25",
      "text": "In this synthetic office scenario, ESG and sustainability requirements favour efficient buildings and refurbishment opportunities. Hybrid working encourages collaborative amenity-rich space but can reduce leased area. Upgrading secondary stock may protect its appeal; retrofit cost and execution risk need assessment before investment.",
      "submarket": "London",
      "category": "esg",
      "demo": true
    }
  ],
