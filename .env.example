# Offline by default. Environment variables are read from the shell; .env is not auto-loaded.
LLM_PROVIDER=offline
LLM_MODEL=gpt-4.1-mini
OPENAI_API_KEY=
# Optional OpenAI-compatible endpoint. Used only with LLM_PROVIDER=openai.
OPENAI_BASE_URL=
LONDON_DATA_DIR=.runtime
# Optional LangGraph/LangSmith tracing; off by default (may transmit evidence).
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
