# Local development: .env loads automatically; exported variables take precedence.
# Compose overrides storage paths and service URLs for its private network.
LONDON_MODE=live
LONDON_DATA_DIR=.runtime
QDRANT_URL=http://localhost:6333
# auto uses the SDK metasearch engines; use duckduckgo to restrict searches.
DDGS_BACKEND=auto
CRAWL4AI_URL=http://localhost:11235
# Generate with: openssl rand -hex 32
CRAWL4AI_API_TOKEN=
EMBEDDING_CACHE=.runtime/embeddings

# Required; no offline provider, automatic model or endpoint fallback.
LLM_PROVIDER=z.ai
ZAI_API_KEY=
ZAI_API_BASE=https://api.z.ai/api/coding/paas/v4
LLM_MODEL=glm-5.3-flash

# Optional LangGraph/LangSmith tracing; off by default (may transmit evidence).
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=

# Optional providers in the dashboard. See README for model selection and limitations.
# All three values must be set for it to appear. Credentials stay on the server.
OPENAI_API_KEY=
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_API_BASE=https://api.anthropic.com/v1
ANTHROPIC_MODEL=
GEMINI_API_KEY=
GEMINI_API_BASE=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_MODEL=
DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE=https://api.deepseek.com
DEEPSEEK_MODEL=
OPENROUTER_API_KEY=
OPENROUTER_API_BASE=https://openrouter.ai/api/v1
OPENROUTER_MODEL=
# The selected LLM_PROVIDER uses LLM_MODEL; other providers use <PREFIX>_MODEL.
# Set ZAI_MODEL to offer z.ai when it is not the primary provider.
ZAI_MODEL=
